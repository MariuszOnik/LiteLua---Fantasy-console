; Textured map vertex shader: position * modelView * projection, texcoord passed on;
; texcoord1 = the paper grain's, from the position (x, z of the unit quad) * grain.xy + grain.zw,
; so the grain runs on across tiles without a seam.

; Uniforms
.fvec projection[4], modelView[4]
.fvec grain

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1

; Inputs: v0 = position (x, y, z), v1 = texcoord (u, v)
.alias inpos v0
.alias intc  v1

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intc

	mul r2.xy, grain.xy, inpos.xz
	add r2.xy, grain.zw, r2.xy
	mov r2.zw, myconst.xx
	mov outtc1, r2
	end
.end
