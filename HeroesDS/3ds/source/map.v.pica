; Overlay vertex shader: position * modelView * projection, colour = tint * shade
; (alpha = tint's alpha).

; Uniforms
.fvec projection[4], modelView[4]
.fvec tint

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outclr color

; Inputs: v0 = position (x, y, z), v1 = shade
.alias inpos   v0
.alias inshade v1

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul r2.xyz, tint.xyz, inshade.xxx
	mov r2.w, tint.w
	mov outclr, r2
	end
.end
