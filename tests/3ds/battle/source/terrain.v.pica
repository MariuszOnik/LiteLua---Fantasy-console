; Terrain and decorations: position * modelView * projection; two texcoords (ground texture
; over the world, hex border by the distance from the hex centre) and a colour (shading).

; Uniforms
.fvec projection[4], modelView[4]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

; Inputs: v0 = position (x, y, z), v1 = texcoord 0, v2 = texcoord 1, v3 = colour (r, g, b)
.alias inpos v0
.alias intc0 v1
.alias intc1 v2
.alias inclr v3

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intc0
	mov outtc1, intc1
	mov r2.xyz, inclr
	mov r2.w,   ones
	mov outclr, r2
	end
.end
