; Morph-animated soldier: the position is blended between two frames of the animation,
; position = a + (b - a) * blend.x, then * modelView * projection; texcoord passed on.

; Uniforms
.fvec projection[4], modelView[4]
.fvec blend

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias  ones  myconst.yyyy

; Outputs
.out outpos position
.out outtc0 texcoord0

; Inputs: v0 = frame a (x, y, z), v1 = frame b (x, y, z), v2 = texcoord (u, v)
.alias ina  v0
.alias inb  v1
.alias intc v2

.proc main
	mov r2.xyz, inb               ; one input register per instruction
	add r1.xyz, r2, -ina
	mul r1.xyz, blend.xxx, r1
	add r0.xyz, ina, r1
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intc
	end
.end
